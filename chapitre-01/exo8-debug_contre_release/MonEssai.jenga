#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
MonEssai.jenga — projet console minimal pour l'exercice 5.
Un main qui ne fait rien, sans dependances.
"""

from Jenga import *
from jengaconfig import *


with project("MonEssai"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/**.cpp"])
    nkentseudependson(
        [],
        extra_includes=["src"],
    )
    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    with filter("system:Windows"):
        usetoolchain(TC_WINDOWS)
    with filter("system:Linux"):
        usetoolchain("clang-native")
    with filter("config:Debug"):
        defines(["_DEBUG", "NKENTSEU_DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG", "NKENTSEU_RELEASE"])
        optimize("Speed")
        symbols(False)
